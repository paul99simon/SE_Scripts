<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.0 ensures Linux compatibility without needing Windows Mono assemblies -->
    <TargetFramework>netstandard2.0</TargetFramework>
    
    <!-- CRITICAL: Forces VS Code to warn you if you type anything newer than C# 6.0 -->
    <LangVersion>6</LangVersion>
    
    <!-- Suppresses the terminal warning about referencing a .NET 4.6 package -->
    <NoWarn>NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SpaceEngineers.ScriptingReferences" Version="1.3.0" />
  </ItemGroup>

</Project>